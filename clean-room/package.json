{
  "name": "command-center-clean-room",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:modules": "tsc -p tsconfig.build.json",
    "build:browser": "node scripts/build-browser.mjs",
    "build": "npm run build:modules && npm run build:browser",
    "check:legacy": "node scripts/check-no-legacy-imports.mjs",
    "audit:repository": "node scripts/category15-repository-audit.mjs",
    "audit:repository:write": "node scripts/category15-repository-audit.mjs --write",
    "test": "npm run check:legacy && npm run audit:repository && npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {"typescript": "^5.8.3"}
}
