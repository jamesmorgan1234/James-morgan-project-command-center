{
  "name": "command-center-clean-room",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "check:legacy": "node scripts/check-no-legacy-imports.mjs",
    "test": "npm run check:legacy && npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {"typescript": "^5.8.3"}
}
