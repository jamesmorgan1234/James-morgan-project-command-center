{
  "name": "command-center-clean-room",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:modules": "tsc -p tsconfig.build.json",
    "build:browser": "node scripts/build-browser.mjs",
    "build": "npm run build:modules && npm run build:browser",
    "check:legacy": "node scripts/check-no-legacy-imports.mjs",
    "audit:repository": "node scripts/category15-repository-audit.mjs --write",
    "audit:artifact": "node scripts/category15-release-artifact-audit.mjs",
    "audit:release-candidate": "node scripts/category15-release-artifact-audit.mjs --require-protected-assets",
    "audit:category15": "node scripts/category15-phase-gate-audit.mjs --write --require-nonproduction --verified-by-prior-gates",
    "audit:production-live": "node scripts/category15-production-live-audit.mjs",
    "test:modules": "node --test tests/*.test.mjs",
    "test": "npm run check:legacy && npm run audit:repository && npm run build && npm run audit:artifact && npm run test:modules && npm run audit:release-candidate && npm run audit:category15 && npm run audit:production-live"
  },
  "devDependencies": {"typescript": "5.8.3"}
}
